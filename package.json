{
  "name": "etherplan",
  "version": "0.0.2-beta",
  "description": "Plan, apply, and verify desired EVM contract state",
  "license": "MIT",
  "type": "module",
  "files": [
    "src/",
    "docs/production-backends.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randyquaye/etherplan.git"
  },
  "bugs": "https://github.com/randyquaye/etherplan/issues",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "etherplan": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/integration/*.test.mjs",
    "check": "for file in src/*.mjs src/*/*.mjs test/*.mjs test/*/*.mjs; do node --check \"$file\" || exit; done"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-kms": "^3.1140.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1140.0",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@cdktn/hcl2json": "0.24.0"
  }
}
